SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
# JWT signing key: PKCS#8 RSA private key (2048+ bits), base64 on one line (PEM header lines optional).
# Create one: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-key.pem
# Without a key the app generates a temporary one, and tokens stop working after a restart.
# IAM_JWT_KEYS_0_KID=key-2026-10
# IAM_JWT_KEYS_0_PRIVATEKEY=MIIEvQIBADANBgkqhkiG9w0BAQEFAASC...
# Browser apps on another origin that may call the API (exact origins, comma-separated; none by default).
# IAM_CORS_ALLOWEDORIGINS=http://localhost:5173
# First super user (the platform root), created at startup while the platform has no root. Read only then.
# IAM_PLATFORM_ROOT_USERNAME=platform-root
# IAM_PLATFORM_ROOT_PASSWORD=Change-me-1!
# IAM_PLATFORM_ROOT_EMAIL=admin@example.com
# IAM_PLATFORM_ROOT_FULL_NAME=Platform Root
