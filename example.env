# Copy to .env and fill in. Every setting is required in every profile (local, dev, stage, prod): a missing one stops
# the startup and is named. Only IAM_PLATFORM_ROOT_* may go once the platform has its root user.
# Don't keep a setting commented out with its equals sign: IntelliJ's .env support reads such a line as a variable,
# and Spring binds it (it drops the "# " from the name). Delete unused settings instead.

# The environment profile (SPRING_PROFILES_ACTIVE): local, dev, stage or prod. ./gradlew bootRun defaults to local and
# docker compose sets dev; IntelliJ's run button needs it here.
SPRING_PROFILES_ACTIVE=local

# Database (docker compose sets its own for its MySQL).
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3366/iam_system_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=password

# The port (8080 when unset) and the public base URL of this IAM (tokens' iss), with the same port locally.
SERVER_PORT=8080
IAM_JWT_ISSUER=http://localhost:8080

# JWT signing key: a PKCS#8 RSA private key (2048+ bits). Create one (*.pem is git-ignored):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-key.pem
# Point to the file (file: prefix, relative to where the app starts). Alternatively, instead of the location, give the
# key itself as IAM_JWT_KEYS_0_PRIVATEKEY (base64 on one line, PEM header lines optional); never both.
IAM_JWT_KEYS_0_KID=key-2026-10
IAM_JWT_KEYS_0_PRIVATEKEYLOCATION=file:./jwt-key.pem
# docker compose mounts the PEM file from this host path into the container.
IAM_JWT_KEY_FILE=./jwt-key.pem

# Mail account that sends the password-reset OTPs.
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# Browser apps on another origin that may call the API (exact origins, comma-separated).
IAM_CORS_ALLOWEDORIGINS=http://localhost:5173

# First super user (the platform root), created at startup while the platform has no root. Read only then, so it
# can be removed afterwards.
IAM_PLATFORM_ROOT_USERNAME=platform-root
IAM_PLATFORM_ROOT_PASSWORD=Change-me-1!
IAM_PLATFORM_ROOT_EMAIL=admin@example.com
IAM_PLATFORM_ROOT_FULL_NAME=Platform Root
